{
	"name": "station-0",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=26.12.0 <27"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "npm run validate:data && npm run check:types && astro build",
		"preview": "astro preview",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"check:deprecated": "node scripts/check-deprecated.ts",
		"check:types": "astro check && svelte-check --tsconfig ./tsconfig.json --threshold error",
		"validate:data": "node scripts/validate-data.ts",
		"notes": "node scripts/print-notes.ts"
	},
	"dependencies": {
		"@astrojs/svelte": "9.1.2",
		"astro": "7.4.4",
		"svelte": "5.57.3",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"@axe-core/playwright": "4.14.0",
		"@biomejs/biome": "2.6.4",
		"@playwright/test": "1.64.1",
		"@types/node": "26.6.6",
		"svelte-check": "4.7.7",
		"typescript": "6.0.3",
		"vitest": "5.0.5"
	}
}
