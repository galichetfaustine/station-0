---
import { Font } from "astro:assets";
import { withBase } from "../lib/paths";
import { SITE } from "../lib/site";
import SiteHeader from "./SiteHeader.astro";
import "../styles/global.css";

interface Props {
	/** Titre de la page, sans le nom du site. Absent sur l'accueil. */
	title?: string;
	description?: string;
	/** L'accueil dessine son menu sur la photo. */
	hideHeader?: boolean;
}

const { title, description = SITE.tagline, hideHeader = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const onHome = Astro.url.pathname === withBase(import.meta.env.BASE_URL, "/");
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<Font cssVariable="--font-barlow-condensed" preload />
		<Font cssVariable="--font-inter" preload />
	</head>
	<body>
		<a class="skip-link" href="#contenu">Aller au contenu</a>
		{hideHeader ? null : <SiteHeader />}
		<main id="contenu" class:list={["container", { "hero-page": onHome }]} tabindex="-1">
			<slot />
		</main>
	</body>
</html>
