---
import { withBase } from "../lib/paths";
import { NAV, SITE } from "../lib/site";

interface Props {
	/** Même menu fin, posé sur la photo de l'accueil. */
	quiet?: boolean;
}

const { quiet = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const current = Astro.url.pathname;
---

<header class:list={["site-header", { quiet }]}>
	<div class="container inner">
		<a class="logo" href={withBase(base, "/")}>{SITE.name}</a>
		<nav aria-label="Navigation principale">
			<ul>
				{
					NAV.map((item) => {
						const href = withBase(base, item.path);
						return (
							<li>
								<a href={href} aria-current={current.startsWith(href) ? "page" : undefined}>
									{item.label}
								</a>
							</li>
						);
					})
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	/* Ligne fine, comme sur l'accueil : petit nom, pas de pastille. */
	.site-header {
		border-bottom: 1px solid var(--color-line);
		color: var(--color-on-ink);
	}

	.inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2);
		padding-block: var(--space-2);
	}

	.logo {
		display: inline-flex;
		align-items: center;
		min-height: var(--tap-min);
		min-width: var(--tap-min);
		font-family: var(--font-text);
		font-size: 1rem;
		font-weight: 500;
		text-transform: none;
		text-decoration: none;
	}

	ul {
		display: flex;
		gap: var(--space-1);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	nav a {
		display: inline-flex;
		align-items: center;
		min-height: var(--tap-min);
		min-width: var(--tap-min);
		padding-inline: var(--space-3);
		border-radius: 0;
		font-size: 0.95rem;
		font-weight: 400;
		text-decoration: none;

		&:hover {
			text-decoration: underline;
		}

		/* Page en cours : soulignée et plus grasse, pas seulement colorée, sans pastille. */
		&[aria-current="page"] {
			font-weight: 700;
			text-decoration: underline;
			text-underline-offset: 0.3em;
		}
	}

	/* Accueil : la même ligne, posée sur la photo. */
	.quiet {
		position: absolute;
		z-index: 2;
		inset: 0 0 auto;
		border-bottom: 0;
		background: transparent;
	}

	.quiet .logo,
	.quiet nav a {
		text-shadow:
			0 1px 10px var(--color-ink),
			0 0 2px var(--color-ink);
	}
</style>
