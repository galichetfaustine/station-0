---
import BaseLayout from "../../components/BaseLayout.astro";
import Catalogue from "../../components/Catalogue.svelte";
import { toCatalogueRace } from "../../lib/catalogue";
import { withBase } from "../../lib/paths";
import { baremeConfig, races } from "../../lib/races-data";

const catalogue = races.map((race) => toCatalogueRace(race, baremeConfig));
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Courses" description="Compare 11 courses hybrides : difficulté notée par catégorie, formats et durée.">
	<h1>Courses</h1>
	<p class="intro">
		11 courses notées de 1 à 5 sur la course à pied, la force, le cardio et la gym, à partir de leur règlement.
		<a href={withBase(base, "/methode/")}>Comment on note</a>
	</p>
	<Catalogue client:load races={catalogue} base={base} />
</BaseLayout>

<style>
	.intro {
		max-width: 40rem;
		color: var(--color-text-muted);
	}
</style>
