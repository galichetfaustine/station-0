---
import { SITE } from "../lib/site";
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{SITE.name}</title>
		<meta name="description" content={SITE.tagline} />
	</head>
	<body>
		<main>
			<h1>{SITE.name}</h1>
			<p>{SITE.tagline}</p>
		</main>
	</body>
</html>
