---
import BaseLayout from "../components/BaseLayout.astro";
import { SITE } from "../lib/site";
---

<BaseLayout>
	<section class="hero">
		<h1>{SITE.name}</h1>
		<p class="tagline">{SITE.tagline}</p>
	</section>
</BaseLayout>

<style>
	.hero {
		padding-block: var(--space-5);
	}

	.tagline {
		max-width: 32rem;
		font-size: 1.25rem;
		color: var(--color-text-muted);
	}
</style>
