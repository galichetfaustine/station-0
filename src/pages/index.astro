---
import BaseLayout from "../components/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { formatNote } from "../lib/bareme";
import { mostAccessible, toCatalogueRace } from "../lib/catalogue";
import { todayInParis } from "../lib/dates";
import { withBase } from "../lib/paths";
import { baremeConfig, events, races } from "../lib/races-data";

const base = import.meta.env.BASE_URL;
const buildDate = todayInParis();
const catalogue = races.map((race) =>
	toCatalogueRace(race, baremeConfig, events, buildDate),
);
const starters = mostAccessible(catalogue, 3, buildDate);
const hero = withBase(base, "/images/hero-course.jpg");

type Dot = "full" | "half" | "empty";

/** 5 pastilles à partir de la note (l'information reste aussi écrite à côté). */
function dots(note: number | null): Dot[] {
	return [0, 1, 2, 3, 4].map((index) => {
		if (note === null || note < index + 0.5) return "empty";
		if (note < index + 1) return "half";
		return "full";
	});
}
---

<BaseLayout hideHeader>
	<section class="hero" style={`--hero: url("${hero}")`}>
		<SiteHeader quiet />
		<div class="hero-copy">
			<h1><span>Trouve ta</span> première course.</h1>
			<p class="pitch">
				HYROX, DEKA, ATHX, Deadly Dozen. {races.length} courses hybrides, notées de 1 à 5 d'après leur règlement.
			</p>
			<a class="button" href={withBase(base, "/courses/")}>Voir les courses</a>
			<p class="quiz-entry">
				<a href={withBase(base, "/quiz/")}>Pas sûr que ce soit pour toi ? Fais le quiz</a>
			</p>
		</div>
	</section>

	<section class="start" aria-labelledby="debuter">
		<h2 id="debuter">Par où commencer</h2>
		<ul class="starters">
			{
				starters.map((race) => (
					<li>
						<a href={withBase(base, `/courses/${race.slug}/`)}>
							<span class="name">{race.nom}</span>
							<span class="note">
								<span class="dots" aria-hidden="true">
									{dots(race.noteGlobale).map((dot) => (
										<i class={dot} />
									))}
								</span>
								<span>
									{formatNote(race.noteGlobale)}
									<span class="max">/5</span>
								</span>
							</span>
						</a>
					</li>
				))
			}
		</ul>
		<p><a class="method" href={withBase(base, "/methode/")}>Comment on note</a></p>
	</section>
</BaseLayout>

<style>
	.hero {
		position: relative;
		display: flex;
		align-items: flex-end;
		justify-content: flex-end;
		min-height: min(88vh, 44rem);
		margin-inline: calc(50% - 50vw);
		width: 100vw;
		padding-block: 6.5rem var(--space-5);
		/* 24 px minimum : le texte ne doit pas toucher le bord de l'écran. */
		padding-inline: max(24px, var(--space-4));
		background-color: var(--color-ink);
		background-image:
			linear-gradient(
				180deg,
				color-mix(in srgb, var(--color-ink) 55%, transparent),
				transparent 7rem
			),
			linear-gradient(
				90deg,
				color-mix(in srgb, var(--color-ink) 15%, transparent) 0%,
				color-mix(in srgb, var(--color-ink) 82%, transparent) 62%
			),
			var(--hero);
		background-position: center;
		background-size: cover;
		color: var(--color-on-ink);
	}

	/* Assez large pour « Trouve ta » et « première » à la taille maximale du titre,
	   sans dépasser l'écran. Le titre est plafonné à cette boîte. */
	.hero-copy {
		width: min(24rem, 100%);
		max-width: 100%;
		min-width: 0;
	}

	h1 {
		max-width: 100%;
		font-size: clamp(4.25rem, 9vw, 6.75rem);
		line-height: 0.86;
		letter-spacing: -0.03em;
		text-transform: none;
		overflow-wrap: normal;
		word-break: normal;
		hyphens: none;
	}

	h1 span {
		display: block;
		color: var(--color-headline);
	}

	.pitch {
		max-width: 100%;
		margin-top: var(--space-3);
		color: var(--color-on-ink-muted);
	}

	.button {
		margin-top: var(--space-4);
	}

	.start {
		padding-top: var(--space-5);
	}

	.quiz-entry a {
		display: inline-block;
		max-width: 100%;
		min-height: var(--tap-min);
		min-width: var(--tap-min);
		padding-block: max(0px, calc((var(--tap-min) - 1lh) / 2));
		white-space: normal;
		overflow-wrap: normal;
		word-break: normal;
		hyphens: none;
	}

	h2 {
		font-size: clamp(2rem, 5vw, 2.75rem);
		text-transform: none;
		letter-spacing: -0.03em;
	}

	.starters {
		max-width: 40rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.starters a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		min-height: var(--tap-min);
		padding-block: var(--space-3);
		border-top: 1px solid var(--color-line);
		text-decoration: none;
	}

	.starters a:hover .name {
		text-decoration: underline;
	}

	.name {
		font-family: var(--font-title);
		font-size: 1.75rem;
		font-weight: 800;
		letter-spacing: 0.01em;
		text-transform: uppercase;
	}

	.note {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-family: var(--font-title);
		font-size: 1.5rem;
		font-weight: 800;
	}

	.dots {
		display: inline-flex;
		gap: 5px;
	}

	.dots i {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--color-text);
	}

	.dots i.empty {
		background: transparent;
		box-shadow: inset 0 0 0 1.5px var(--color-line);
	}

	.dots i.half {
		background: linear-gradient(90deg, var(--color-text) 50%, transparent 50%);
		box-shadow: inset 0 0 0 1.5px var(--color-text);
	}

	.max {
		font-size: 1rem;
		color: var(--color-text-muted);
	}

	.method {
		display: inline-flex;
		align-items: center;
		min-height: var(--tap-min);
	}

	@media (max-width: 40rem) {
		.hero {
			align-items: flex-end;
			justify-content: flex-start;
			background-image:
				linear-gradient(
					180deg,
					color-mix(in srgb, var(--color-ink) 50%, transparent),
					transparent 6rem
				),
				linear-gradient(
					180deg,
					transparent 30%,
					color-mix(in srgb, var(--color-ink) 90%, transparent) 68%
				),
				var(--hero);
		}

		.hero-copy {
			width: 100%;
		}
	}
</style>
